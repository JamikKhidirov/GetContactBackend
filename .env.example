# ---------------------------------------------------------------------------
# GetContact API — example environment.
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
SERVICE_NAME=getcontact-api
APP_VERSION=1.2.0

# HTTP ----------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=90s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_REQUEST_TIMEOUT=20s
METRICS_ADDR=:8081                  # worker exposes metrics here; API uses /metrics

# PostgreSQL ----------------------------------------------------------------
DATABASE_URL=postgres://getcontact:getcontact@localhost:5432/getcontact?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_CONNECT_TIMEOUT=10s

# Redis ---------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=60s

# Kafka ---------------------------------------------------------------------
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=getcontact.events
KAFKA_DLQ_TOPIC=getcontact.events.dlq
KAFKA_GROUP_ID=getcontact-workers

# Auth ----------------------------------------------------------------------
# Production requires at least 32 characters.
JWT_SECRET=dev-only-super-secret-key-change-me-please
JWT_ISSUER=getcontact
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_THREADS=2
ARGON2_KEY_LEN=32

# Email OTP -----------------------------------------------------------------
# log  = print the email (with the code) to the worker log; free, local only.
# smtp = send through any SMTP server: Gmail, Mailtrap, Resend, Brevo, etc.
EMAIL_ENABLED=true
EMAIL_PROVIDER=log
EMAIL_FROM_NAME=GetContact
EMAIL_FROM_ADDRESS=no-reply@getcontact.local
EMAIL_REPLY_TO=
EMAIL_SUPPORT_ADDRESS=support@getcontact.local
EMAIL_BRAND_NAME=GetContact
EMAIL_CODE_TTL=10m
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_COOLDOWN=60s
# Production requires a unique value of 32+ characters.
EMAIL_CODE_SECRET=dev-email-code-secret-change-me-please
# Only honoured in development; never returned in production.
EMAIL_DEV_ECHO=true
EMAIL_OUTBOX_INTERVAL=1s
EMAIL_OUTBOX_BATCH=50
EMAIL_OUTBOX_MAX_ATTEMPTS=25

# SMTP (required when EMAIL_PROVIDER=smtp)
# Gmail: enable 2FA, create an App Password, then use:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password  SMTP_TLS=true
# Mailtrap / Resend / Brevo use the same fields with their own host and port.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_TIMEOUT=10s

# CORS ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-Id

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_RPM=120
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_WINDOW=1m

# Bootstrap admin (optional) ------------------------------------------------
# On startup the phone is promoted to role=admin and the password is reset.
ADMIN_PHONE=+79990000000
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Platform Admin
